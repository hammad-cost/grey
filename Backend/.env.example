# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (local dev):
#   DATABASE_URL=sqlite+aiosqlite:///./grey.db
# PostgreSQL / Supabase (production):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/grey
DATABASE_URL=sqlite+aiosqlite:///./grey.db

# ── CORS ───────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# ── Search tool (evidence research) ────────────────────────────────────────────
# Release 0.2 supports only "mock" (sample data, no API key needed).
SEARCH_PROVIDER=mock
# Pause per mock search in milliseconds, so research progress is visible in the UI.
MOCK_SEARCH_DELAY_MS=400
