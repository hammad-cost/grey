# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── App ────────────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (local dev):
#   DATABASE_URL=sqlite+aiosqlite:///./grey.db
# PostgreSQL / Supabase (production):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/grey
DATABASE_URL=sqlite+aiosqlite:///./grey.db

# ── CORS ───────────────────────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# ── Search tool (evidence research) ────────────────────────────────────────────
# Search providers in fallback order.
#   mock           = sample data, no API key needed (default)
#   serpapi,tavily = real web search (needs the keys below; Release 0.4)
SEARCH_PROVIDERS=mock

# Keys for real search — put them in .env only, never commit them.
# SerpAPI: https://serpapi.com/manage-api-key   Tavily: https://app.tavily.com
SERPAPI_API_KEY=
TAVILY_API_KEY=
# Most searches one research run may make (defaults shown).
# RESEARCH_MAX_SEARCHES=15
# Most searches one dataset search may make (defaults shown).
# DATASET_MAX_SEARCHES=6
# Optional limits (defaults shown).
# SEARCH_TIMEOUT_SECONDS=20
# SEARCH_MAX_RETRIES=2
# SEARCH_COOLDOWN_SECONDS=60
# SEARCH_QUOTA_COOLDOWN_SECONDS=3600
# Pause per mock search in milliseconds, so research progress is visible in the UI.
MOCK_SEARCH_DELAY_MS=400

# ── LLM (Release 0.3) ──────────────────────────────────────────────────────────
# fake = no real model calls (default; no key needed). live = use real providers.
LLM_MODE=fake

# Groq key from https://console.groq.com/keys — put it in .env only, never commit it.
GROQ_API_KEY=

# Optional: override which models a profile uses (ordered "provider:model" list).
# LLM_PROFILE_STRUCTURED_REASONING=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# Optional limits (defaults shown).
# LLM_TIMEOUT_SECONDS=60
# LLM_TOTAL_DEADLINE_SECONDS=150
# LLM_MAX_RETRIES=2
# LLM_COOLDOWN_SECONDS=60
# LLM_QUOTA_COOLDOWN_SECONDS=3600
