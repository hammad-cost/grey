# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Backend ────────────────────────────────────────────────────────────────────
# URL of the Grey FastAPI backend.
# NEXT_PUBLIC_ prefix makes this available in the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── CopilotKit ─────────────────────────────────────────────────────────────────
# Leave blank in Release 0.1 — no AI chat runtime is connected yet.
# This will be set when the chat feature is added in a future release.
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=
